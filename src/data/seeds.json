[
  {
    "id": "sales-ae-comp-plan",
    "description": "Model quota attainment, accelerated commission, and total cash compensation for an account executive.",
    "blocks": [
      {
        "id": "sales-heading",
        "type": "heading",
        "level": 1,
        "inline": ["AE compensation & accelerator"]
      },
      {
        "id": "sales-intro",
        "type": "paragraph",
        "inline": [
          "A compact annual plan for testing quota attainment and the upside above target. Move closed ARR to see the narrative and compensation update together."
        ]
      },
      {
        "id": "sales-base-salary",
        "type": "number",
        "varId": "sales-base-salary-var",
        "name": "BaseSalary",
        "value": 70000,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "sales-target-variable",
        "type": "number",
        "varId": "sales-target-variable-var",
        "name": "TargetVariablePay",
        "value": 70000,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "sales-annual-quota",
        "type": "number",
        "varId": "sales-annual-quota-var",
        "name": "AnnualQuota",
        "value": 700000,
        "format": "currency",
        "currency": "EUR",
        "min": 1
      },
      {
        "id": "sales-closed-arr",
        "type": "slider",
        "varId": "sales-closed-arr-var",
        "name": "ClosedArr",
        "value": 875000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "max": 1400000,
        "step": 25000
      },
      {
        "id": "sales-accelerator",
        "type": "number",
        "varId": "sales-accelerator-var",
        "name": "AcceleratorMultiplier",
        "value": 1.5,
        "min": 1,
        "max": 3
      },
      {
        "id": "sales-ote",
        "type": "formula",
        "varId": "sales-ote-var",
        "name": "OnTargetEarnings",
        "formula": "BaseSalary + TargetVariablePay"
      },
      {
        "id": "sales-base-rate",
        "type": "formula",
        "varId": "sales-base-rate-var",
        "name": "BaseCommissionRate",
        "formula": "TargetVariablePay / AnnualQuota"
      },
      {
        "id": "sales-attainment",
        "type": "formula",
        "varId": "sales-attainment-var",
        "name": "QuotaAttainment",
        "formula": "ClosedArr / AnnualQuota"
      },
      {
        "id": "sales-earned-commission",
        "type": "formula",
        "varId": "sales-earned-commission-var",
        "name": "EarnedCommission",
        "formula": "ClosedArr <= AnnualQuota ? ClosedArr * BaseCommissionRate : AnnualQuota * BaseCommissionRate + (ClosedArr - AnnualQuota) * BaseCommissionRate * AcceleratorMultiplier"
      },
      {
        "id": "sales-total-comp",
        "type": "formula",
        "varId": "sales-total-comp-var",
        "name": "TotalCashCompensation",
        "formula": "BaseSalary + EarnedCommission"
      },
      {
        "id": "sales-summary",
        "type": "paragraph",
        "inline": [
          "At ",
          {
            "name": "ClosedArr",
            "type": "ref",
            "varId": "sales-closed-arr-var"
          },
          " of closed ARR, the AE reaches ",
          {
            "name": "QuotaAttainment",
            "type": "ref",
            "varId": "sales-attainment-var"
          },
          " attainment and earns ",
          {
            "name": "EarnedCommission",
            "type": "ref",
            "varId": "sales-earned-commission-var"
          },
          " in commission."
        ]
      },
      {
        "id": "sales-takeaway",
        "type": "bulletListItem",
        "inline": [
          "Total annual cash compensation becomes ",
          {
            "name": "TotalCashCompensation",
            "type": "ref",
            "varId": "sales-total-comp-var"
          },
          " versus OTE of ",
          {
            "name": "OnTargetEarnings",
            "type": "ref",
            "varId": "sales-ote-var"
          },
          "."
        ]
      }
    ]
  },
  {
    "id": "founders-runway-plan",
    "description": "See how cash, recurring burn, and an optional hire change the company runway.",
    "blocks": [
      {
        "id": "founders-heading",
        "type": "heading",
        "level": 1,
        "inline": ["Founder runway planner"]
      },
      {
        "id": "founders-intro",
        "type": "paragraph",
        "inline": [
          "A monthly cash model for a small team deciding whether now is the right moment to add one more person."
        ]
      },
      {
        "id": "founders-cash",
        "type": "number",
        "varId": "founders-cash-var",
        "name": "CashBalance",
        "value": 420000,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "founders-revenue",
        "type": "number",
        "varId": "founders-revenue-var",
        "name": "MonthlyRevenue",
        "value": 28000,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "founders-costs",
        "type": "slider",
        "varId": "founders-costs-var",
        "name": "MonthlyOperatingCosts",
        "value": 52000,
        "format": "currency",
        "currency": "EUR",
        "min": 10000,
        "max": 120000,
        "step": 1000
      },
      {
        "id": "founders-hire-choice",
        "type": "select",
        "varId": "founders-hire-choice-var",
        "name": "HireEnabled",
        "value": 1,
        "options": [
          {
            "label": "Not yet",
            "value": 0
          },
          {
            "label": "Yes, hire now",
            "value": 1
          }
        ]
      },
      {
        "id": "founders-hire-cost",
        "type": "number",
        "varId": "founders-hire-cost-var",
        "name": "HireMonthlyCost",
        "value": 8500,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "founders-total-costs",
        "type": "formula",
        "varId": "founders-total-costs-var",
        "name": "TotalMonthlyCosts",
        "formula": "MonthlyOperatingCosts + HireEnabled * HireMonthlyCost"
      },
      {
        "id": "founders-net-burn",
        "type": "formula",
        "varId": "founders-net-burn-var",
        "name": "MonthlyNetBurn",
        "formula": "TotalMonthlyCosts - MonthlyRevenue"
      },
      {
        "id": "founders-runway",
        "type": "formula",
        "varId": "founders-runway-var",
        "name": "RunwayMonths",
        "formula": "CashBalance / max(MonthlyNetBurn, 1)"
      },
      {
        "id": "founders-summary",
        "type": "paragraph",
        "inline": [
          "With monthly costs of ",
          {
            "name": "TotalMonthlyCosts",
            "type": "ref",
            "varId": "founders-total-costs-var"
          },
          " and revenue of ",
          {
            "name": "MonthlyRevenue",
            "type": "ref",
            "varId": "founders-revenue-var"
          },
          ", net burn is ",
          {
            "name": "MonthlyNetBurn",
            "type": "ref",
            "varId": "founders-net-burn-var"
          },
          "."
        ]
      },
      {
        "id": "founders-takeaway",
        "type": "bulletListItem",
        "inline": [
          "The current cash balance funds approximately ",
          {
            "name": "RunwayMonths",
            "type": "ref",
            "varId": "founders-runway-var"
          },
          " at this pace. Toggle the hire to compare the decision instantly."
        ]
      }
    ]
  },
  {
    "id": "valencia-rent-vs-mortgage",
    "description": "Compare monthly rent with the estimated carrying cost of buying a home in Valencia.",
    "blocks": [
      {
        "id": "valencia-heading",
        "type": "heading",
        "level": 1,
        "inline": ["Rent vs mortgage in Valencia"]
      },
      {
        "id": "valencia-intro",
        "type": "paragraph",
        "inline": [
          "A practical EUR comparison for a resale flat in Valencia, including financing, community fees, IBI, insurance, and a maintenance reserve."
        ]
      },
      {
        "id": "valencia-rent",
        "type": "slider",
        "varId": "valencia-rent-var",
        "name": "MonthlyRent",
        "value": 1450,
        "format": "currency",
        "currency": "EUR",
        "min": 700,
        "max": 2500,
        "step": 25
      },
      {
        "id": "valencia-price",
        "type": "number",
        "varId": "valencia-price-var",
        "name": "PurchasePrice",
        "value": 320000,
        "format": "currency",
        "currency": "EUR",
        "min": 50000
      },
      {
        "id": "valencia-down-payment",
        "type": "number",
        "varId": "valencia-down-payment-var",
        "name": "DownPayment",
        "value": 64000,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "valencia-rate",
        "type": "number",
        "varId": "valencia-rate-var",
        "name": "AnnualInterestRate",
        "value": 3.25,
        "format": "percent",
        "min": 0.1,
        "max": 12
      },
      {
        "id": "valencia-term",
        "type": "select",
        "varId": "valencia-term-var",
        "name": "MortgageYears",
        "value": 30,
        "options": [
          {
            "label": "20 years",
            "value": 20
          },
          {
            "label": "25 years",
            "value": 25
          },
          {
            "label": "30 years",
            "value": 30
          }
        ]
      },
      {
        "id": "valencia-community-fees",
        "type": "number",
        "varId": "valencia-community-fees-var",
        "name": "MonthlyCommunityFees",
        "value": 85,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "valencia-ibi",
        "type": "number",
        "varId": "valencia-ibi-var",
        "name": "AnnualIbi",
        "value": 620,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "valencia-insurance",
        "type": "number",
        "varId": "valencia-insurance-var",
        "name": "AnnualHomeInsurance",
        "value": 360,
        "format": "currency",
        "currency": "EUR",
        "min": 0
      },
      {
        "id": "valencia-maintenance-rate",
        "type": "number",
        "varId": "valencia-maintenance-rate-var",
        "name": "AnnualMaintenanceRate",
        "value": 0.6,
        "format": "percent",
        "min": 0,
        "max": 3
      },
      {
        "id": "valencia-loan",
        "type": "formula",
        "varId": "valencia-loan-var",
        "name": "LoanPrincipal",
        "formula": "PurchasePrice - DownPayment"
      },
      {
        "id": "valencia-monthly-rate",
        "type": "formula",
        "varId": "valencia-monthly-rate-var",
        "name": "MonthlyInterestRate",
        "formula": "AnnualInterestRate / 12"
      },
      {
        "id": "valencia-payment-count",
        "type": "formula",
        "varId": "valencia-payment-count-var",
        "name": "MortgagePaymentCount",
        "formula": "MortgageYears * 12"
      },
      {
        "id": "valencia-mortgage-payment",
        "type": "formula",
        "varId": "valencia-mortgage-payment-var",
        "name": "MonthlyMortgagePayment",
        "formula": "LoanPrincipal * (MonthlyInterestRate * (1 + MonthlyInterestRate) ^ MortgagePaymentCount) / ((1 + MonthlyInterestRate) ^ MortgagePaymentCount - 1)"
      },
      {
        "id": "valencia-owner-cost",
        "type": "formula",
        "varId": "valencia-owner-cost-var",
        "name": "MonthlyOwnerCost",
        "formula": "MonthlyMortgagePayment + MonthlyCommunityFees + AnnualIbi / 12 + AnnualHomeInsurance / 12 + PurchasePrice * AnnualMaintenanceRate / 12"
      },
      {
        "id": "valencia-difference",
        "type": "formula",
        "varId": "valencia-difference-var",
        "name": "BuyingMonthlyPremium",
        "formula": "MonthlyOwnerCost - MonthlyRent"
      },
      {
        "id": "valencia-summary",
        "type": "paragraph",
        "inline": [
          "For a ",
          {
            "name": "PurchasePrice",
            "type": "ref",
            "varId": "valencia-price-var"
          },
          " home, the estimated monthly owner cost is ",
          {
            "name": "MonthlyOwnerCost",
            "type": "ref",
            "varId": "valencia-owner-cost-var"
          },
          ", compared with rent of ",
          {
            "name": "MonthlyRent",
            "type": "ref",
            "varId": "valencia-rent-var"
          },
          "."
        ]
      },
      {
        "id": "valencia-takeaway",
        "type": "bulletListItem",
        "inline": [
          "On a cash-flow basis, buying costs ",
          {
            "name": "BuyingMonthlyPremium",
            "type": "ref",
            "varId": "valencia-difference-var"
          },
          " more per month at these assumptions. This excludes one-off purchase taxes and notary or registry costs."
        ]
      }
    ]
  },
  {
    "id": "block-gallery",
    "description": "One block of every type, every number format, and both failure states, for testing the editor.",
    "blocks": [
      {
        "id": "gallery-title",
        "type": "heading",
        "level": 1,
        "inline": ["Block gallery"]
      },
      {
        "id": "gallery-intro",
        "type": "paragraph",
        "inline": [
          "Every block type, every number format, and both failure states, in one notebook. Open it after an editor change and read down the page."
        ]
      },
      {
        "id": "gallery-prose-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Prose"]
      },
      {
        "id": "gallery-prose-sub",
        "type": "heading",
        "level": 3,
        "inline": ["A level 3 heading"]
      },
      {
        "id": "gallery-prose-plain",
        "type": "paragraph",
        "inline": ["A plain paragraph. It carries no styles and no references."]
      },
      {
        "id": "gallery-prose-styled",
        "type": "paragraph",
        "inline": [
          "Styled runs: ",
          {
            "styles": {
              "bold": true
            },
            "text": "bold",
            "type": "text"
          },
          ", ",
          {
            "styles": {
              "italic": true
            },
            "text": "italic",
            "type": "text"
          },
          ", ",
          {
            "styles": {
              "underline": true
            },
            "text": "underline",
            "type": "text"
          },
          ", ",
          {
            "styles": {
              "strike": true
            },
            "text": "strikethrough",
            "type": "text"
          },
          ", and ",
          {
            "styles": {
              "code": true
            },
            "text": "code",
            "type": "text"
          },
          "."
        ]
      },
      {
        "id": "gallery-bullet-1",
        "type": "bulletListItem",
        "inline": ["The first bullet item."]
      },
      {
        "id": "gallery-bullet-2",
        "type": "bulletListItem",
        "inline": ["The second bullet item, with a nested child."],
        "children": [
          {
            "id": "gallery-bullet-2-child",
            "type": "bulletListItem",
            "inline": ["A nested bullet item."]
          }
        ]
      },
      {
        "id": "gallery-number-1",
        "type": "numberedListItem",
        "inline": ["The first numbered item."]
      },
      {
        "id": "gallery-number-2",
        "type": "numberedListItem",
        "inline": ["The second numbered item."]
      },
      {
        "id": "gallery-check-1",
        "type": "checkListItem",
        "props": {
          "checked": true
        },
        "inline": ["A checked item."]
      },
      {
        "id": "gallery-check-2",
        "type": "checkListItem",
        "props": {
          "checked": false
        },
        "inline": ["An unchecked item."]
      },
      {
        "id": "gallery-divider",
        "type": "divider"
      },
      {
        "id": "gallery-inputs-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Inputs"]
      },
      {
        "id": "gallery-inputs-note",
        "type": "paragraph",
        "inline": ["One block per input type, and one per number format."]
      },
      {
        "id": "gallery-plain-number",
        "type": "number",
        "varId": "gallery-plain-number-var",
        "name": "PlainNumber",
        "value": 42,
        "min": 0
      },
      {
        "id": "gallery-money-eur",
        "type": "number",
        "varId": "gallery-money-eur-var",
        "name": "MoneyEur",
        "value": 1234.5,
        "format": "currency",
        "currency": "EUR"
      },
      {
        "id": "gallery-money-usd",
        "type": "number",
        "varId": "gallery-money-usd-var",
        "name": "MoneyUsd",
        "value": 99,
        "format": "currency",
        "currency": "USD",
        "decimals": 2
      },
      {
        "id": "gallery-growth-rate",
        "type": "number",
        "varId": "gallery-growth-rate-var",
        "name": "GrowthRate",
        "value": 12.5,
        "format": "percent"
      },
      {
        "id": "gallery-distance",
        "type": "number",
        "varId": "gallery-distance-var",
        "name": "DistanceKm",
        "value": 12.5,
        "format": "unit",
        "unit": "km"
      },
      {
        "id": "gallery-precise",
        "type": "number",
        "varId": "gallery-precise-var",
        "name": "PreciseNumber",
        "value": 3.14159,
        "decimals": 4
      },
      {
        "id": "gallery-slider-basic",
        "type": "slider",
        "varId": "gallery-slider-basic-var",
        "name": "SliderBasic",
        "value": 60,
        "min": 0,
        "max": 100,
        "step": 5
      },
      {
        "id": "gallery-slider-money",
        "type": "slider",
        "varId": "gallery-slider-money-var",
        "name": "SliderMoney",
        "value": 180000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "max": 500000,
        "step": 10000
      },
      {
        "id": "gallery-slider-percent",
        "type": "slider",
        "varId": "gallery-slider-percent-var",
        "name": "SliderPercent",
        "value": 35,
        "format": "percent",
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "id": "gallery-select",
        "type": "select",
        "varId": "gallery-select-var",
        "name": "PlanTier",
        "value": 1,
        "options": [
          {
            "label": "Starter",
            "value": 0
          },
          {
            "label": "Growth",
            "value": 1
          },
          {
            "label": "Scale",
            "value": 2
          }
        ]
      },
      {
        "id": "gallery-boolean",
        "type": "boolean",
        "varId": "gallery-boolean-var",
        "name": "FeatureOn",
        "value": 1
      },
      {
        "id": "gallery-formulas-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Formulas"]
      },
      {
        "id": "gallery-formulas-note",
        "type": "paragraph",
        "inline": [
          "Short names, long names, and long expressions, so the row can be measured at both ends."
        ]
      },
      {
        "id": "gallery-sum",
        "type": "formula",
        "varId": "gallery-sum-var",
        "name": "Sum",
        "formula": "PlainNumber + SliderBasic"
      },
      {
        "id": "gallery-tier",
        "type": "formula",
        "varId": "gallery-tier-var",
        "name": "TierMultiplier",
        "formula": "PlanTier + 1"
      },
      {
        "id": "gallery-gated",
        "type": "formula",
        "varId": "gallery-gated-var",
        "name": "GatedTotal",
        "formula": "FeatureOn ? MoneyEur * 2 : MoneyEur"
      },
      {
        "id": "gallery-long-name",
        "type": "formula",
        "varId": "gallery-long-name-var",
        "name": "ADeliberatelyLongVariableNameForLayout",
        "formula": "MoneyEur"
      },
      {
        "id": "gallery-long-formula",
        "type": "formula",
        "varId": "gallery-long-formula-var",
        "name": "LongExpression",
        "formula": "MoneyEur * (1 + GrowthRate) * TierMultiplier + SliderMoney * SliderPercent - MoneyEur * SliderPercent / 2"
      },
      {
        "id": "gallery-errors-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Failure states"]
      },
      {
        "id": "gallery-errors-note",
        "type": "paragraph",
        "inline": [
          "Both blocks below are wrong on purpose. Neither may render a zero."
        ]
      },
      {
        "id": "gallery-missing",
        "type": "formula",
        "varId": "gallery-missing-var",
        "name": "MissingDependency",
        "formula": "MoneyEur / UnknownVariable"
      },
      {
        "id": "gallery-broken",
        "type": "formula",
        "varId": "gallery-broken-var",
        "name": "BrokenSyntax",
        "formula": "MoneyEur * * 2"
      },
      {
        "id": "gallery-refs-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Inline references"]
      },
      {
        "id": "gallery-refs-ok",
        "type": "paragraph",
        "inline": [
          "A chip per status. This one is fine: ",
          {
            "name": "Sum",
            "type": "ref",
            "varId": "gallery-sum-var"
          },
          ". So is this currency chip: ",
          {
            "name": "MoneyEur",
            "type": "ref",
            "varId": "gallery-money-eur-var"
          },
          ", and this percent chip: ",
          {
            "name": "GrowthRate",
            "type": "ref",
            "varId": "gallery-growth-rate-var"
          },
          "."
        ]
      },
      {
        "id": "gallery-refs-bad",
        "type": "paragraph",
        "inline": [
          "These two must read as failures, never as zero: ",
          {
            "name": "MissingDependency",
            "type": "ref",
            "varId": "gallery-missing-var"
          },
          " and ",
          {
            "name": "BrokenSyntax",
            "type": "ref",
            "varId": "gallery-broken-var"
          },
          "."
        ]
      },
      {
        "id": "gallery-refs-list",
        "type": "bulletListItem",
        "inline": [
          "A reference inside a list item: ",
          {
            "name": "GatedTotal",
            "type": "ref",
            "varId": "gallery-gated-var"
          },
          "."
        ]
      }
    ]
  }
]
