[
  {
    "id": "sales-ae-comp-plan",
    "description": "Model quota attainment, accelerated commission, and total cash compensation for an account executive.",
    "blocks": [
      {
        "id": "sales-heading",
        "type": "heading",
        "level": 1,
        "inline": ["AE compensation & accelerator"]
      },
      {
        "id": "sales-intro",
        "type": "paragraph",
        "inline": [
          "A compact annual plan for testing quota attainment and the upside above target. Move closed ARR to see the narrative and compensation update together."
        ]
      },
      {
        "id": "sales-base-salary",
        "type": "number",
        "varId": "sales-base-salary-var",
        "name": "base_salary",
        "value": 70000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 1000
      },
      {
        "id": "sales-target-variable",
        "type": "number",
        "varId": "sales-target-variable-var",
        "name": "target_variable_pay",
        "value": 70000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 1000
      },
      {
        "id": "sales-annual-quota",
        "type": "number",
        "varId": "sales-annual-quota-var",
        "name": "annual_quota",
        "value": 700000,
        "format": "currency",
        "currency": "EUR",
        "min": 1,
        "step": 10000
      },
      {
        "id": "sales-closed-arr",
        "type": "slider",
        "varId": "sales-closed-arr-var",
        "name": "closed_arr",
        "value": 875000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "max": 1400000,
        "step": 25000
      },
      {
        "id": "sales-accelerator",
        "type": "number",
        "varId": "sales-accelerator-var",
        "name": "accelerator_multiplier",
        "value": 1.5,
        "min": 1,
        "max": 3,
        "step": 0.1
      },
      {
        "id": "sales-ote",
        "type": "formula",
        "varId": "sales-ote-var",
        "name": "on_target_earnings",
        "formula": "base_salary + target_variable_pay"
      },
      {
        "id": "sales-base-rate",
        "type": "formula",
        "varId": "sales-base-rate-var",
        "name": "base_commission_rate",
        "formula": "target_variable_pay / annual_quota"
      },
      {
        "id": "sales-attainment",
        "type": "formula",
        "varId": "sales-attainment-var",
        "name": "quota_attainment",
        "formula": "closed_arr / annual_quota"
      },
      {
        "id": "sales-earned-commission",
        "type": "formula",
        "varId": "sales-earned-commission-var",
        "name": "earned_commission",
        "formula": "closed_arr <= annual_quota ? closed_arr * base_commission_rate : annual_quota * base_commission_rate + (closed_arr - annual_quota) * base_commission_rate * accelerator_multiplier"
      },
      {
        "id": "sales-total-comp",
        "type": "formula",
        "varId": "sales-total-comp-var",
        "name": "total_cash_compensation",
        "formula": "base_salary + earned_commission"
      },
      {
        "id": "sales-summary",
        "type": "paragraph",
        "inline": [
          "At ",
          {
            "name": "closed_arr",
            "type": "ref",
            "varId": "sales-closed-arr-var"
          },
          " of closed ARR, the AE reaches ",
          {
            "name": "quota_attainment",
            "type": "ref",
            "varId": "sales-attainment-var"
          },
          " attainment and earns ",
          {
            "name": "earned_commission",
            "type": "ref",
            "varId": "sales-earned-commission-var"
          },
          " in commission."
        ]
      },
      {
        "id": "sales-takeaway",
        "type": "bulletListItem",
        "inline": [
          "Total annual cash compensation becomes ",
          {
            "name": "total_cash_compensation",
            "type": "ref",
            "varId": "sales-total-comp-var"
          },
          " versus OTE of ",
          {
            "name": "on_target_earnings",
            "type": "ref",
            "varId": "sales-ote-var"
          },
          "."
        ]
      }
    ]
  },
  {
    "id": "founders-runway-plan",
    "description": "See how cash, recurring burn, and an optional hire change the company runway.",
    "blocks": [
      {
        "id": "founders-heading",
        "type": "heading",
        "level": 1,
        "inline": ["Founder runway planner"]
      },
      {
        "id": "founders-intro",
        "type": "paragraph",
        "inline": [
          "A monthly cash model for a small team deciding whether now is the right moment to add one more person."
        ]
      },
      {
        "id": "founders-cash",
        "type": "number",
        "varId": "founders-cash-var",
        "name": "cash_balance",
        "value": 420000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 10000
      },
      {
        "id": "founders-revenue",
        "type": "number",
        "varId": "founders-revenue-var",
        "name": "monthly_revenue",
        "value": 28000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 1000
      },
      {
        "id": "founders-costs",
        "type": "slider",
        "varId": "founders-costs-var",
        "name": "monthly_operating_costs",
        "value": 52000,
        "format": "currency",
        "currency": "EUR",
        "min": 10000,
        "max": 120000,
        "step": 1000
      },
      {
        "id": "founders-hire-choice",
        "type": "select",
        "varId": "founders-hire-choice-var",
        "name": "hire_enabled",
        "value": 1,
        "options": [
          {
            "label": "Not yet",
            "value": 0
          },
          {
            "label": "Yes, hire now",
            "value": 1
          }
        ]
      },
      {
        "id": "founders-hire-cost",
        "type": "number",
        "varId": "founders-hire-cost-var",
        "name": "hire_monthly_cost",
        "value": 8500,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 500
      },
      {
        "id": "founders-total-costs",
        "type": "formula",
        "varId": "founders-total-costs-var",
        "name": "total_monthly_costs",
        "formula": "monthly_operating_costs + hire_enabled * hire_monthly_cost"
      },
      {
        "id": "founders-net-burn",
        "type": "formula",
        "varId": "founders-net-burn-var",
        "name": "monthly_net_burn",
        "formula": "total_monthly_costs - monthly_revenue"
      },
      {
        "id": "founders-runway",
        "type": "formula",
        "varId": "founders-runway-var",
        "name": "runway_months",
        "formula": "cash_balance / max(monthly_net_burn, 1)"
      },
      {
        "id": "founders-summary",
        "type": "paragraph",
        "inline": [
          "With monthly costs of ",
          {
            "name": "total_monthly_costs",
            "type": "ref",
            "varId": "founders-total-costs-var"
          },
          " and revenue of ",
          {
            "name": "monthly_revenue",
            "type": "ref",
            "varId": "founders-revenue-var"
          },
          ", net burn is ",
          {
            "name": "monthly_net_burn",
            "type": "ref",
            "varId": "founders-net-burn-var"
          },
          "."
        ]
      },
      {
        "id": "founders-takeaway",
        "type": "bulletListItem",
        "inline": [
          "The current cash balance funds approximately ",
          {
            "name": "runway_months",
            "type": "ref",
            "varId": "founders-runway-var"
          },
          " at this pace. Toggle the hire to compare the decision instantly."
        ]
      }
    ]
  },
  {
    "id": "valencia-rent-vs-mortgage",
    "description": "Compare monthly rent with the estimated carrying cost of buying a home in Valencia.",
    "blocks": [
      {
        "id": "valencia-heading",
        "type": "heading",
        "level": 1,
        "inline": ["Rent vs mortgage in Valencia"]
      },
      {
        "id": "valencia-intro",
        "type": "paragraph",
        "inline": [
          "A practical EUR comparison for a resale flat in Valencia, including financing, community fees, IBI, insurance, and a maintenance reserve."
        ]
      },
      {
        "id": "valencia-rent",
        "type": "slider",
        "varId": "valencia-rent-var",
        "name": "monthly_rent",
        "value": 1450,
        "format": "currency",
        "currency": "EUR",
        "min": 700,
        "max": 2500,
        "step": 25
      },
      {
        "id": "valencia-price",
        "type": "number",
        "varId": "valencia-price-var",
        "name": "purchase_price",
        "value": 320000,
        "format": "currency",
        "currency": "EUR",
        "min": 50000,
        "step": 5000
      },
      {
        "id": "valencia-down-payment",
        "type": "number",
        "varId": "valencia-down-payment-var",
        "name": "down_payment",
        "value": 64000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 5000
      },
      {
        "id": "valencia-rate",
        "type": "number",
        "varId": "valencia-rate-var",
        "name": "annual_interest_rate",
        "value": 3.25,
        "format": "percent",
        "min": 0.1,
        "max": 12,
        "step": 0.05
      },
      {
        "id": "valencia-term",
        "type": "select",
        "varId": "valencia-term-var",
        "name": "mortgage_years",
        "value": 30,
        "options": [
          {
            "label": "20 years",
            "value": 20
          },
          {
            "label": "25 years",
            "value": 25
          },
          {
            "label": "30 years",
            "value": 30
          }
        ]
      },
      {
        "id": "valencia-community-fees",
        "type": "number",
        "varId": "valencia-community-fees-var",
        "name": "monthly_community_fees",
        "value": 85,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 5
      },
      {
        "id": "valencia-ibi",
        "type": "number",
        "varId": "valencia-ibi-var",
        "name": "annual_ibi",
        "value": 620,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 20
      },
      {
        "id": "valencia-insurance",
        "type": "number",
        "varId": "valencia-insurance-var",
        "name": "annual_home_insurance",
        "value": 360,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "step": 20
      },
      {
        "id": "valencia-maintenance-rate",
        "type": "number",
        "varId": "valencia-maintenance-rate-var",
        "name": "annual_maintenance_rate",
        "value": 0.6,
        "format": "percent",
        "min": 0,
        "max": 3,
        "step": 0.1
      },
      {
        "id": "valencia-loan",
        "type": "formula",
        "varId": "valencia-loan-var",
        "name": "loan_principal",
        "formula": "purchase_price - down_payment"
      },
      {
        "id": "valencia-monthly-rate",
        "type": "formula",
        "varId": "valencia-monthly-rate-var",
        "name": "monthly_interest_rate",
        "formula": "annual_interest_rate / 12"
      },
      {
        "id": "valencia-payment-count",
        "type": "formula",
        "varId": "valencia-payment-count-var",
        "name": "mortgage_payment_count",
        "formula": "mortgage_years * 12"
      },
      {
        "id": "valencia-mortgage-payment",
        "type": "formula",
        "varId": "valencia-mortgage-payment-var",
        "name": "monthly_mortgage_payment",
        "formula": "loan_principal * (monthly_interest_rate * (1 + monthly_interest_rate) ^ mortgage_payment_count) / ((1 + monthly_interest_rate) ^ mortgage_payment_count - 1)"
      },
      {
        "id": "valencia-owner-cost",
        "type": "formula",
        "varId": "valencia-owner-cost-var",
        "name": "monthly_owner_cost",
        "formula": "monthly_mortgage_payment + monthly_community_fees + annual_ibi / 12 + annual_home_insurance / 12 + purchase_price * annual_maintenance_rate / 12"
      },
      {
        "id": "valencia-difference",
        "type": "formula",
        "varId": "valencia-difference-var",
        "name": "buying_monthly_premium",
        "formula": "monthly_owner_cost - monthly_rent"
      },
      {
        "id": "valencia-summary",
        "type": "paragraph",
        "inline": [
          "For a ",
          {
            "name": "purchase_price",
            "type": "ref",
            "varId": "valencia-price-var"
          },
          " home, the estimated monthly owner cost is ",
          {
            "name": "monthly_owner_cost",
            "type": "ref",
            "varId": "valencia-owner-cost-var"
          },
          ", compared with rent of ",
          {
            "name": "monthly_rent",
            "type": "ref",
            "varId": "valencia-rent-var"
          },
          "."
        ]
      },
      {
        "id": "valencia-takeaway",
        "type": "bulletListItem",
        "inline": [
          "On a cash-flow basis, buying costs ",
          {
            "name": "buying_monthly_premium",
            "type": "ref",
            "varId": "valencia-difference-var"
          },
          " more per month at these assumptions. This excludes one-off purchase taxes and notary or registry costs."
        ]
      }
    ]
  },
  {
    "id": "block-gallery",
    "description": "One block of every type, every number format, and both failure states, for testing the editor.",
    "blocks": [
      {
        "id": "gallery-title",
        "type": "heading",
        "level": 1,
        "inline": ["Block gallery"]
      },
      {
        "id": "gallery-intro",
        "type": "paragraph",
        "inline": [
          "Every block type, every number format, and both failure states, in one notebook. Open it after an editor change and read down the page."
        ]
      },
      {
        "id": "gallery-prose-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Prose"]
      },
      {
        "id": "gallery-prose-sub",
        "type": "heading",
        "level": 3,
        "inline": ["A level 3 heading"]
      },
      {
        "id": "gallery-prose-plain",
        "type": "paragraph",
        "inline": ["A plain paragraph. It carries no styles and no references."]
      },
      {
        "id": "gallery-prose-styled",
        "type": "paragraph",
        "inline": [
          "Styled runs: ",
          {
            "styles": {
              "bold": true
            },
            "text": "bold",
            "type": "text"
          },
          ", ",
          {
            "styles": {
              "italic": true
            },
            "text": "italic",
            "type": "text"
          },
          ", ",
          {
            "styles": {
              "underline": true
            },
            "text": "underline",
            "type": "text"
          },
          ", ",
          {
            "styles": {
              "strike": true
            },
            "text": "strikethrough",
            "type": "text"
          },
          ", and ",
          {
            "styles": {
              "code": true
            },
            "text": "code",
            "type": "text"
          },
          "."
        ]
      },
      {
        "id": "gallery-bullet-1",
        "type": "bulletListItem",
        "inline": ["The first bullet item."]
      },
      {
        "id": "gallery-bullet-2",
        "type": "bulletListItem",
        "inline": ["The second bullet item, with a nested child."],
        "children": [
          {
            "id": "gallery-bullet-2-child",
            "type": "bulletListItem",
            "inline": ["A nested bullet item."]
          }
        ]
      },
      {
        "id": "gallery-number-1",
        "type": "numberedListItem",
        "inline": ["The first numbered item."]
      },
      {
        "id": "gallery-number-2",
        "type": "numberedListItem",
        "inline": ["The second numbered item."]
      },
      {
        "id": "gallery-check-1",
        "type": "checkListItem",
        "props": {
          "checked": true
        },
        "inline": ["A checked item."]
      },
      {
        "id": "gallery-check-2",
        "type": "checkListItem",
        "props": {
          "checked": false
        },
        "inline": ["An unchecked item."]
      },
      {
        "id": "gallery-divider",
        "type": "divider"
      },
      {
        "id": "gallery-inputs-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Inputs"]
      },
      {
        "id": "gallery-inputs-note",
        "type": "paragraph",
        "inline": ["One block per input type, and one per number format."]
      },
      {
        "id": "gallery-plain-number",
        "type": "number",
        "varId": "gallery-plain-number-var",
        "name": "plain_number",
        "value": 42,
        "min": 0,
        "step": 1
      },
      {
        "id": "gallery-money-eur",
        "type": "number",
        "varId": "gallery-money-eur-var",
        "name": "money_eur",
        "value": 1234.5,
        "format": "currency",
        "currency": "EUR",
        "step": 100
      },
      {
        "id": "gallery-money-usd",
        "type": "number",
        "varId": "gallery-money-usd-var",
        "name": "money_usd",
        "value": 99,
        "format": "currency",
        "currency": "USD",
        "decimals": 2,
        "step": 1
      },
      {
        "id": "gallery-growth-rate",
        "type": "number",
        "varId": "gallery-growth-rate-var",
        "name": "growth_rate",
        "value": 12.5,
        "format": "percent",
        "step": 0.5
      },
      {
        "id": "gallery-distance",
        "type": "number",
        "varId": "gallery-distance-var",
        "name": "distance_km",
        "value": 12.5,
        "format": "unit",
        "unit": "km",
        "step": 0.5
      },
      {
        "id": "gallery-precise",
        "type": "number",
        "varId": "gallery-precise-var",
        "name": "precise_number",
        "value": 3.14159,
        "decimals": 4,
        "step": 0.0001
      },
      {
        "id": "gallery-slider-basic",
        "type": "slider",
        "varId": "gallery-slider-basic-var",
        "name": "slider_basic",
        "value": 60,
        "min": 0,
        "max": 100,
        "step": 5
      },
      {
        "id": "gallery-slider-money",
        "type": "slider",
        "varId": "gallery-slider-money-var",
        "name": "slider_money",
        "value": 180000,
        "format": "currency",
        "currency": "EUR",
        "min": 0,
        "max": 500000,
        "step": 10000
      },
      {
        "id": "gallery-slider-percent",
        "type": "slider",
        "varId": "gallery-slider-percent-var",
        "name": "slider_percent",
        "value": 35,
        "format": "percent",
        "min": 0,
        "max": 100,
        "step": 1
      },
      {
        "id": "gallery-select",
        "type": "select",
        "varId": "gallery-select-var",
        "name": "plan_tier",
        "value": 1,
        "options": [
          {
            "label": "Starter",
            "value": 0
          },
          {
            "label": "Growth",
            "value": 1
          },
          {
            "label": "Scale",
            "value": 2
          }
        ]
      },
      {
        "id": "gallery-boolean",
        "type": "boolean",
        "varId": "gallery-boolean-var",
        "name": "feature_on",
        "value": 1
      },
      {
        "id": "gallery-formulas-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Formulas"]
      },
      {
        "id": "gallery-formulas-note",
        "type": "paragraph",
        "inline": [
          "Short names, long names, and long expressions, so the row can be measured at both ends."
        ]
      },
      {
        "id": "gallery-sum",
        "type": "formula",
        "varId": "gallery-sum-var",
        "name": "sum",
        "formula": "plain_number + slider_basic"
      },
      {
        "id": "gallery-tier",
        "type": "formula",
        "varId": "gallery-tier-var",
        "name": "tier_multiplier",
        "formula": "plan_tier + 1"
      },
      {
        "id": "gallery-gated",
        "type": "formula",
        "varId": "gallery-gated-var",
        "name": "gated_total",
        "formula": "feature_on ? money_eur * 2 : money_eur"
      },
      {
        "id": "gallery-long-name",
        "type": "formula",
        "varId": "gallery-long-name-var",
        "name": "a_deliberately_long_variable_name_for_layout",
        "formula": "money_eur"
      },
      {
        "id": "gallery-long-formula",
        "type": "formula",
        "varId": "gallery-long-formula-var",
        "name": "long_expression",
        "formula": "money_eur * (1 + growth_rate) * tier_multiplier + slider_money * slider_percent - money_eur * slider_percent / 2"
      },
      {
        "id": "gallery-errors-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Failure states"]
      },
      {
        "id": "gallery-errors-note",
        "type": "paragraph",
        "inline": [
          "Both blocks below are wrong on purpose. Neither may render a zero."
        ]
      },
      {
        "id": "gallery-missing",
        "type": "formula",
        "varId": "gallery-missing-var",
        "name": "missing_dependency",
        "formula": "money_eur / unknown_variable"
      },
      {
        "id": "gallery-broken",
        "type": "formula",
        "varId": "gallery-broken-var",
        "name": "broken_syntax",
        "formula": "money_eur * * 2"
      },
      {
        "id": "gallery-refs-heading",
        "type": "heading",
        "level": 2,
        "inline": ["Inline references"]
      },
      {
        "id": "gallery-refs-ok",
        "type": "paragraph",
        "inline": [
          "A chip per status. This one is fine: ",
          {
            "name": "sum",
            "type": "ref",
            "varId": "gallery-sum-var"
          },
          ". So is this currency chip: ",
          {
            "name": "money_eur",
            "type": "ref",
            "varId": "gallery-money-eur-var"
          },
          ", and this percent chip: ",
          {
            "name": "growth_rate",
            "type": "ref",
            "varId": "gallery-growth-rate-var"
          },
          "."
        ]
      },
      {
        "id": "gallery-refs-bad",
        "type": "paragraph",
        "inline": [
          "These two must read as failures, never as zero: ",
          {
            "name": "missing_dependency",
            "type": "ref",
            "varId": "gallery-missing-var"
          },
          " and ",
          {
            "name": "broken_syntax",
            "type": "ref",
            "varId": "gallery-broken-var"
          },
          "."
        ]
      },
      {
        "id": "gallery-refs-list",
